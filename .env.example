# Root env example. See backend/env.example for the full backend configuration.
# Copy backend/env.example -> backend/.env and fill in values before running the API.

# Minimal local backend config:
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/skillmatch-1
JWT_SECRET=change-me-in-production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
